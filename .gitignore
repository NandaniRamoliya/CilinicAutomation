# dependencies / local tooling
node_modules/
.n8n-local/

# Real client data stays OUT of git. Only the template + demo are committed.
clients/*
!clients/_template/
!clients/demo-clinic/
clients/**/.deployed.json

# Build output: only the demo build is committed (so anyone can import without building)
dist/*
!dist/demo-clinic/

# secrets
.env
*.env
*.local.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
